APP_ENV=dev

# Optional hard override. If set, this takes precedence over profile URLs.
DATABASE_URL=

# Used when APP_ENV=dev and DATABASE_URL is not set.
DEV_DATABASE_URL=sqlite+aiosqlite:///./stockverse.db

# Used when APP_ENV=prod and DATABASE_URL is not set.
PROD_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockverse

SECRET_KEY=change_this_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_REQUEST_LIMIT=5
OTP_WINDOW_SECONDS=900
